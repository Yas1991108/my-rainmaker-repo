<?xml version="1.0" encoding="utf-8"?>
<!--
    المسار: app/src/main/res/layout/dialog_card_customization.xml
    تخطيط BottomSheet لتخصيص البطاقة
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/color_card_background"
    android:paddingBottom="32dp">

    <!-- العنوان -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/customize_card"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/color_text"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- ===== عجلة الألوان ===== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_background_color"
        android:textColor="@color/color_text"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <com.larswerkman.holocolorpicker.ColorPicker
        android:id="@+id/color_picker"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        app:color_center_halo_radius="30dp"
        app:color_center_radius="25dp"
        app:color_pointer_halo_radius="10dp"
        app:color_pointer_radius="8dp"
        app:color_wheel_radius="110dp"
        app:color_wheel_thickness="22dp" />

    <com.larswerkman.holocolorpicker.SVBar
        android:id="@+id/sv_bar"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <!-- ===== شكل البطاقة ===== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_card_style"
        android:textColor="@color/color_text"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_card_styles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <!-- ===== أيقونة الجهاز ===== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_icon"
        android:textColor="@color/color_text"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_icons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <!-- ===== زر استعادة الافتراضي ===== -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_reset_default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reset_to_default"
        android:backgroundTint="@color/color_orange"
        android:textColor="@android:color/white"
        android:padding="12dp"
        app:cornerRadius="8dp" />

</LinearLayout>

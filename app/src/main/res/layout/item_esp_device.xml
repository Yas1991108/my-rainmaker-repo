<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardCornerRadius="16dp"
    card_view:cardElevation="5dp"
    card_view:cardUseCompatPadding="true"
    card_view:cardBackgroundColor="@color/color_card_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <!-- زر التخصيص (ثلاث نقاط) -->
            <ImageView
                android:id="@+id/btn_customize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_more"
                android:tint="@color/color_text"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true" />

            <!-- اسم الجهاز -->
            <TextView
                android:id="@+id/tv_device_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/btn_customize"
                android:layout_alignParentTop="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Smart Bulb"
                android:textColor="@color/color_text"
                android:textSize="16sp"
                android:layout_marginEnd="8dp" />

            <!-- أيقونة الجهاز -->
            <LinearLayout
                android:id="@+id/ll_device_icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_device_name"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:weightSum="1">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="0.70"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_device"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="3dp"
                        android:src="@drawable/ic_device_switch" />

                </LinearLayout>

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="0.30">

                    <ImageView
                        android:id="@+id/iv_on_off"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/ic_output_disable"
                        android:visibility="gone" />

                    <com.aar.tapholdupbutton.TapHoldUpButton
                        android:id="@+id/btn_trigger"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_alignParentEnd="true"
                        android:visibility="gone"
                        app:thub_circleColor="@color/colorPrimary"
                        app:thub_circleColorOhHold="@color/colorAccent"
                        app:thub_circleGap="3dp"
                        app:thub_ringColor="@color/colorPrimary"
                        app:thub_ringStrokeWidth="2dp" />

                    <TextView
                        android:id="@+id/tv_string"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="Test"
                        android:textColor="@color/color_dark_gray"
                        android:visibility="visible"
                        app:autoSizeMaxTextSize="20sp"
                        app:autoSizeMinTextSize="11sp"
                        app:autoSizeStepGranularity="2sp"
                        app:autoSizeTextType="uniform" />

                </RelativeLayout>

            </LinearLayout>

            <!-- حالة الاتصال -->
            <RelativeLayout
                android:id="@+id/ll_offline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/ll_device_icon"
                android:layout_marginTop="8dp"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/iv_offline"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_status_offline" />

                <ImageView
                    android:id="@+id/iv_secure_local"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/margin_8"
                    android:src="@drawable/ic_lock"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/tv_offline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_toEndOf="@id/iv_offline"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Offline"
                    android:textColor="@color/colorAccent"
                    android:textSize="12sp" />

            </RelativeLayout>

        </RelativeLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

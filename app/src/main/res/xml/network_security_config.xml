<?xml version="1.0" encoding="utf-8"?>
<!--
    ملف أمان الشبكة — يسمح بـ HTTP لجميع الـ IPs المحلية
    ESP32 قد تحصل على أي IP من الراوتر (مثال: 192.168.0.128)
    لذلك نسمح بـ HTTP لجميع نطاقات الشبكات الخاصة
-->
<network-security-config>

    <!-- السماح بـ HTTP لجميع الاتصالات (للتطوير والاختبار) -->
    <!-- هذا ضروري لأن ESP32 يمكن أن تحصل على أي IP -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
